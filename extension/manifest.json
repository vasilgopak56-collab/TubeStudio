{
  "manifest_version": 3,
  "name": "TubeStudio — Outlier, VPH и заполнение YouTube Studio",
  "short_name": "TubeStudio",
  "version": "1.2.0",
  "description": "VPH/Outlier по кнопке, сохранение темы в локальный TubeStudio и заполнение названия, описания и тегов в YouTube Studio из карточки публикации.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TubeStudio",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://[::1]/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "studio.js"
      ],
      "css": [
        "studio.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
